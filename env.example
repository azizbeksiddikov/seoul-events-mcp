# All optional. Names only; never commit real values.
# Free key from https://data.seoul.go.kr (Seoul Open Data Plaza). Without it the public "sample" key is used (max 5 culture events per day).
SEOUL_OPEN_API_KEY=
# Eventify GraphQL endpoint. Default: https://eventify.azbek.me/api/graphql
EVENTIFY_API_URL=
# Cache lifetime in seconds. Default: 600
CACHE_TTL_SECONDS=
# Port for --http mode. Default: 3000
PORT=
